{
  "name": "pdf-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Free PDF tools that run entirely in your browser. Files never leave your device.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs"
  },
  "license": "MIT",
  "dependencies": {
