{
  "rewrites": [
    { "source": "/tools", "destination": "/tools.html" },
    { "source": "/:tool(merge-pdf|split-pdf|organize-pdf|rotate-pdf|delete-pages|extract-pages|compress-pdf|jpg-to-pdf|pdf-to-jpg|number-pages|watermark-pdf|protect-pdf|unlock-pdf|flatten-pdf)", "destination": "/tool.html?tool=:tool" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'" }
    ] }
  ]
}
